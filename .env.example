# Copy to .env and fill in. The firewall runs without these (demo mode);
# they are only needed for the live /proxy-chat route.

# Anthropic API key — enables live Claude responses on /proxy-chat.
ANTHROPIC_API_KEY=

# Model used to answer prompts that pass the firewall.
AEGIS_PROXY_MODEL=claude-opus-4-8

# Risk score (0-100) at or above which a prompt is BLOCKED.
AEGIS_BLOCK_THRESHOLD=40
